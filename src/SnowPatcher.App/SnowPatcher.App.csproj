<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(LocalAppData)/SnowPatcher/BuildSettings.props"
          Condition="'$(LocalAppData)' != '' and Exists('$(LocalAppData)/SnowPatcher/BuildSettings.props')" />
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>SnowPatcher</AssemblyName>
    <Product>SnowPatcher</Product>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SnowPatcherModioApiKey Condition="'$(SnowPatcherModioApiKey)' == ''">$(SNOWPATCHER_MODIO_API_KEY)</SnowPatcherModioApiKey>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.6" />
    <ProjectReference Include="../SnowPatcher.Core/SnowPatcher.Core.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(SnowPatcherModioApiKey)' != ''">
    <AssemblyMetadata Include="SnowPatcher.ModioApiKey" Value="$(SnowPatcherModioApiKey)" />
  </ItemGroup>
</Project>
