<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SnowPatcher.App.Views.CompatibilityDetailsWindow"
        Title="Compatibility" Width="620" Height="300" MinWidth="460" MinHeight="240"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12" RowDefinitions="Auto,*,Auto" RowSpacing="10">
    <TextBlock x:Name="ModName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <TextBox Grid.Row="1" x:Name="Details" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
             ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Compatibility details" />
    <Button Grid.Row="2" Content="Close" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="OnClose" />
  </Grid>
</Window>
