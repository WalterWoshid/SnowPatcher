<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SnowPatcher.App.ViewModels"
        x:Class="SnowPatcher.App.Views.RestoreBackupWindow"
        x:DataType="vm:RestoreBackupViewModel"
        Title="Backups" Width="600" Height="390" MinWidth="500" MinHeight="320"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="12" RowDefinitions="*,Auto,Auto,Auto" RowSpacing="10">
    <ListBox x:Name="BackupList" ItemsSource="{Binding Backups}" IsEnabled="{Binding CanSelect}"
             SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
             Background="White" BorderBrush="#A0A0A0" BorderThickness="1"
             AutomationProperties.Name="Available backups">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
      </ListBox.Styles>
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:BackupItemViewModel">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,3" MinHeight="48">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="2" VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}" IsVisible="{Binding ShowName}"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
              <TextBox Classes="backupNameEditor" Text="{Binding DraftName, Mode=TwoWay}"
                       IsVisible="{Binding IsEditing}" PlaceholderText="{Binding AutomaticName}"
                       ToolTip.Tip="Leave empty to use the original backup description." AutomationProperties.Name="Backup name" />
              <TextBlock Grid.Row="1" Text="{Binding Details}" IsVisible="{Binding HasName}" FontSize="11" />
            </Grid>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <Button Classes="renameBackup" Width="32" Height="32" MinWidth="32" Padding="7"
                      IsVisible="{Binding ShowRename}" ToolTip.Tip="Rename" AutomationProperties.Name="{Binding RenameLabel}"
                      Click="OnRename">
                <PathIcon Width="14" Height="14" Data="M3,17.25 L3,21 L6.75,21 L17.81,9.94 L14.06,6.19 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 Z" />
              </Button>
              <Button Classes="acceptBackupName" Width="32" Height="32" MinWidth="32" Padding="7"
                      IsVisible="{Binding IsEditing}" ToolTip.Tip="Save name" AutomationProperties.Name="Save backup name"
                      Click="OnAcceptName">
                <PathIcon Width="14" Height="14" Data="M9,16.2 L4.8,12 L3.4,13.4 L9,19 L21,7 L19.6,5.6 Z" />
              </Button>
              <Button Classes="cancelBackupName" Width="32" Height="32" MinWidth="32" Padding="7"
                      IsVisible="{Binding IsEditing}" ToolTip.Tip="Cancel renaming" AutomationProperties.Name="Cancel renaming"
                      Click="OnCancelName">
                <PathIcon Width="14" Height="14" Data="M6,4 L12,10 L18,4 L20,6 L14,12 L20,18 L18,20 L12,14 L6,20 L4,18 L10,12 L4,6 Z" />
              </Button>
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
    <TextBlock Grid.Row="1" Text="{Binding BlockReason}" TextWrapping="Wrap"
               IsVisible="{Binding BlockReason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <TextBlock Grid.Row="2" Text="{Binding Message}" TextWrapping="Wrap"
               IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Close" IsCancel="True" IsEnabled="{Binding CanSelect}" Click="OnCancel" />
      <Button Content="Restore" IsEnabled="{Binding CanRestore}" Click="OnRestore" />
    </StackPanel>
  </Grid>
</Window>
